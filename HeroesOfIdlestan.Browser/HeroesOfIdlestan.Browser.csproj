<Project Sdk="Microsoft.NET.Sdk">
  <!-- Head navigateur (WebAssembly). Déployé sur GitHub Pages par .github/workflows/deploy-web.yml. -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>HeroesOfIdlestan.Browser</RootNamespace>
    <!-- Bootstrapper du runtime WASM : importe dotnet.js et lance Main. -->
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <!-- Requis par [JSImport] : sans cela le générateur d'interop ne tourne pas. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Le SDK WASM désactive par défaut la sérialisation JSON par réflexion. Or GameState passe par
      JsonSerializer sans source generator : sans cette ligne, le chargement échoue sur
      JsonSerializerIsReflectionDisabled et la page reste noire.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Même raison : le trimming retirerait des types que seule la réflexion atteint, et une sauvegarde
         se rechargerait incomplète sans erreur. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Hôte de `dotnet run` : sans lui, WasmAppHost s'arrête sur "no perHostConfigs found". -->
  <ItemGroup>
    <HostConfig Include="browser" host="browser" IsDefault="true" />
  </ItemGroup>
  <PropertyGroup>
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Browser" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeroesOfIdlestan.UI\HeroesOfIdlestan.UI.csproj" />
  </ItemGroup>

  <!--
    Page et module d'interop, copiés à la racine du bundle avec leur hiérarchie. main.js est exclu :
    WasmMainJSPath le déploie déjà.
  -->
  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**" Exclude="wwwroot\main.js"
                            TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
