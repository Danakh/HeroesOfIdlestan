<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Couche Render, pile Godot : rendu 3D du combat, caméra, sortie audio Godot, runtime. Pendant de
    Core.Render (Skia) sans en dépendre : ne référence que Core.Presentation. Voir design/08-godot.md.
  -->
  <PropertyGroup>
    <RootNamespace>HeroesOfIdlestan.Core.Render.Godot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Même version que Godot.NET.Sdk dans HeroesOfIdlestan.App.Godot et que l'éditeur. -->
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeroesOfIdlestan.Core.Presentation\HeroesOfIdlestan.Core.Presentation.csproj" />
  </ItemGroup>
</Project>
