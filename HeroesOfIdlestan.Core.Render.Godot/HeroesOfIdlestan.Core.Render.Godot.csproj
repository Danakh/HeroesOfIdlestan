<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Couche View, version Godot : rendu 3D du combat, caméra, sons, runtime. Remplace Core.Render
    (Skia) sans en dépendre : ne référence que Core.Controller. Voir design/08-godot.md.
  -->
  <PropertyGroup>
    <RootNamespace>HeroesOfIdlestan.Core.Render.Godot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Même version que Godot.NET.Sdk dans HeroesOfIdlestan.App.Godot et que l'éditeur. -->
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Bruitages : les WAV produits par assets/sounds/generate_sounds.py, lus là où le script les écrit
      plutôt que recopiés. Embarqués sous le même nom qu'avec Skia (voir Audio/SoundBank.cs).
    -->
    <EmbeddedResource Include="..\HeroesOfIdlestan.Core.Render\Resources\sounds\*.wav"
                      Link="Resources\sounds\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeroesOfIdlestan.Core.Controller\HeroesOfIdlestan.Core.Controller.csproj" />
  </ItemGroup>
</Project>
