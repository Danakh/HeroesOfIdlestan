<Project Sdk="Microsoft.NET.Sdk">
  <!-- Couche Render, pile Skia : rendu SkiaSharp du monde, caméra, input, écrans, runtime. Aucune dépendance Avalonia. -->
  <PropertyGroup>
    <RootNamespace>HeroesOfIdlestan.Core.Render</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- SVG des habillages d'animation : voir Animation/SkinRenderer.cs. -->
    <PackageReference Include="Svg.Skia" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Planches de sprites produites par Tool.SpriteSheet (design/09), chargées par SpriteSheet.LoadEmbedded.
      Nom de ressource : sprites/<dossier>/<fichier> (séparateur normalisé au chargement).
    -->
    <EmbeddedResource Include="../assets/sprites/**/*.sprites.json;../assets/sprites/**/*.png"
                      LogicalName="sprites/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeroesOfIdlestan.Test.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeroesOfIdlestan.Core.Presentation\HeroesOfIdlestan.Core.Presentation.csproj" />
  </ItemGroup>
</Project>
